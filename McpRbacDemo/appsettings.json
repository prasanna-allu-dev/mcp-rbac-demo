{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mcprbac.db"
  },
  "Rbac": {
    "UserIdHeader": "X-User-Id",
    "ToolPermissions": {
      "inventory_lookup": [ "Admin", "Manager" ],
      "generate_report": [ "Admin", "Manager", "Viewer" ],
      "manage_users": [ "Admin" ],
      "audit_log": [ "Admin" ],
      "system_status": [ "Admin", "Manager", "Viewer" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "McpRbacDemo": "Debug"
    }
  }
}
